<?xml version="1.0" encoding="utf-8"?>
<!-- Lazarus PDF's buttons: #252a33 with a #3a4150 border and 6 dp corners, #2e3440 when pressed -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#2E3440" />
            <stroke android:width="1dp" android:color="#3A4150" />
            <corners android:radius="6dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="#252A33" />
            <stroke android:width="1dp" android:color="#3A4150" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</selector>
